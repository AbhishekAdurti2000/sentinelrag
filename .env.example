# Copy this file to .env and fill in your own values. Never commit .env.

# Required to run the agent for real (not required for the deterministic test/eval suite).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without it, the GitHub connector still works but is limited to ~60
# unauthenticated requests/hour. A classic PAT with public_repo (read) scope is plenty.
GITHUB_TOKEN=ghp_...

# The live data source: any public (or accessible) GitHub repo, "owner/name" format.
SENTINELRAG_REPO=langchain-ai/langgraph

# Claude model to use for the agent's planner/synthesizer nodes.
SENTINELRAG_MODEL=claude-sonnet-4-5

# Where the long-term memory SQLite DB and local cache live.
SENTINELRAG_DATA_DIR=./data
